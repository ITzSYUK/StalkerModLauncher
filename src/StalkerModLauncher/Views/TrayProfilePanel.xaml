<Window x:Class="StalkerModLauncher.Views.TrayProfilePanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:StalkerModLauncher.Views.Controls"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        Deactivated="Window_OnDeactivated"
        Closed="Window_OnClosed">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CORDON;component/Themes/Palette.xaml"/>
                <ResourceDictionary Source="/CORDON;component/Themes/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}"/>
            <Style x:Key="InlineProfileActionButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource BaseButtonStyle}">
                <Setter Property="Width" Value="29"/>
                <Setter Property="Height" Value="29"/>
                <Setter Property="MinHeight" Value="29"/>
                <Setter Property="Padding" Value="5"/>
                <Setter Property="Margin" Value="2,0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="PanelRoot"
          Width="250"
          MaxHeight="510"
          Margin="8"
          CacheMode="BitmapCache"
          SnapsToDevicePixels="True"
          RenderTransformOrigin="0.5,1">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="PanelTranslate" Y="10"/>
        </Grid.RenderTransform>
        <Grid.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
        </Grid.Effect>
        <controls:ProfileSidebarView x:Name="ProfileSidebar"
                                     IsTrayMode="True"
                                     Width="250"
                                     MinHeight="150"
                                     MaxHeight="510"
                                     OpenLauncherRequested="ProfileSidebar_OnOpenLauncherRequested"/>
    </Grid>
</Window>
